  "risks": {
    "shape": [
      "dIncome1 and dRpincome are discrete binned earnings; synthetic data can flatten high-income bins or oversample zeros",
      "dHour89, dWeek89, and dTravtime are discrete labor/commute bins that should remain nonnegative and integer-like",
      "dAge is a coarse age bin, not a raw year; treating it as a unique fingerprint is still a privacy risk",
      "many categoricals (dPOB, dAncstry1, dOccup, dIndustry, iImmigr) have rare codes that are easy to drop or amplify"
    ],
    "trend": [
      "hours/weeks/income triples must stay labor-supply coherent",
      "citizenship vs place of birth and language vs English proficiency must not form impossible combinations",
      "occupation/industry/class-of-worker combinations should not be sampled independently",
      "marital status vs household relationship must stay coherent, including sex-marked labels"
    ],
    "privacy": [
      "configured privacy columns are dAge, iSex, iMarital, dPOB, and iCitizen, following the adult-style quasi-identifier pattern",
      "(dAge, iSex, iMarital, dPOB, iCitizen) plus ancestry/language/immigration context can become a strong nearest-neighbor handle",
      "rare place-of-birth, ancestry, and immigration codes are high-risk identifiers when paired with age and sex",
      "current code-derived bounds require broad col_ps for 32 features, but col_ps must not include the target and should not copy the entire feature set"
    ],
    "utility": [
      "dropping dIncome1 or iYearsch from utility scope substantially weakens poverty classification",
      "poverty=1 is the minority class at about 16%; synthetic data should preserve positive-class coverage",
      "occupation, industry, hours, and labor-force status jointly carry employment-related poverty signal",
      "col_u should usually be dIncome1, iYearsch, dOccup, dHour89, or dRpincome; never use the target column"
    ]
  },
